# Multi-tenancy Configuration for pwd.yml
# Copy this file and modify the values as needed

# Database Configuration
DB_PASSWORD=admin
DB_HOST=db
DB_PORT=3306

# Site Configuration - Add your tenant sites here
# Format: site1.domain.com,site2.domain.com,site3.domain.com
TENANT_SITES=tenant1.localhost,tenant2.localhost,tenant3.localhost

# Default site (first site in the list will be default)
DEFAULT_SITE=tenant1.localhost

# Admin Configuration
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=admin

# Redis Configuration
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
SOCKETIO_PORT=9000

# Nginx Configuration
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Port Configuration for different tenants
TENANT1_PORT=8095
TENANT2_PORT=8096
TENANT3_PORT=8097 